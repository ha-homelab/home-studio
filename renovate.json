{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "npm",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    ".github/cosign/**"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)([^/]*[-_])?requirements[^/]*\\.(txt|pip)$/"
    ]
  },
  "packageRules": [
    {
      "description": "Browser versions and package integrity are qualified together in scripts/browser-matrix.json; update that reviewed matrix before changing the current Playwright lock.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "playwright",
        "playwright-core"
      ],
      "enabled": false
    }
  ]
}
