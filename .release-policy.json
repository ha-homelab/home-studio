{
  "repository": "ha-homelab/home-studio",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "version_file": "custom_components/home_floorplan/manifest.json",
  "validation_workflows": [
    "package.yml",
    "codeql.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "python3 scripts/validate-site.py",
    "python3 scripts/test-install-home-assistant.py",
    "python3 scripts/test-public-package.py",
    "python3 scripts/test_package_release.py",
    "python3 scripts/test-ha-project-metadata.py",
    "python3 scripts/test-ha-native.py"
  ],
  "notes": [
    "Release ZIPs contain only the reviewed public website/compiler inventory and fictional examples. Personal project.json, generated homes and credentials are excluded.",
    "GitHub Pages remains an independent existing deployment workflow. Offline geometry fuzzing does not establish Home Assistant or physical device acceptance."
  ],
  "release_notes": "CHANGELOG.md",
  "single_entry_ci": true,
  "fuzzing": {
    "toolkit_ref": "6b2d99519d513d2b871d2a845ddd6134dea4af2c"
  },
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "custom_components/home_floorplan/manifest.json",
        "format": "json",
        "field": "version",
        "value": "package"
      }
    ],
    "artifacts": [
      {
        "path": "home-studio-*.zip",
        "format": "zip-json",
        "member": "home-studio/custom_components/home_floorplan/manifest.json",
        "field": "version",
        "value": "package"
      },
      {
        "path": "home-studio.version.json",
        "format": "json",
        "field": "version",
        "value": "package"
      },
      {
        "path": "home_floorplan.zip",
        "format": "zip-json",
        "member": "manifest.json",
        "field": "version",
        "value": "package"
      }
    ],
    "toolkit_revision": "d5f62f4c50362c4489df834e5df56924ebdee593"
  },
  "toolkit_revision": "d5f62f4c50362c4489df834e5df56924ebdee593",
  "closed_build": {
    "workflow": "closed-build.yml",
    "environment": "closed-build",
    "enabled": true
  }
}
